# ==============================================================================
# DO NOT EDIT IN PLACE — copy to .env (git-ignored)
# ==============================================================================
# This template is tracked in git. Copy to .env before filling in real values:
#   cp .env.gcp-demo .env  (or Copy-Item .env.gcp-demo .env)
# ==============================================================================
#
# Mango-Mas V2 — Google Cloud Platform (GCP) Demonstration Environment Template.
#
# Configures local CLI execution targeting live GCP services with 100% contract
# parity to local LM Studio / SQLite workflows (spec-0049).
#
# Prerequisites before running live commands:
#   1. gcloud auth application-default login
#   2. gcloud config set project <YOUR_GCP_PROJECT_ID>
#   3. pip install -e ".[dev,cloud,rag]"
#   4. If using Cloud SQL: start Cloud SQL Auth Proxy on 127.0.0.1:5432
#
# Validated by tests/deploy/test_env_example_contract.py (every name resolves to Settings).

# ── Application & Logging ─────────────────────────────────────────────────────
MANGOMAS_ENV=dev
MANGOMAS_LOG_LEVEL=DEBUG
MANGOMAS_LOG__FORMAT=json
MANGOMAS_LOG__BODY_TRUNCATE=512

# ── Vertex AI LLM (Gemini) ───────────────────────────────────────────────────
# Switches LLM adapter from local LM Studio to Vertex AI foundation models.
MANGOMAS_LLM__PROVIDER=vertex
MANGOMAS_LLM__PROJECT_ID=your-gcp-project-id
MANGOMAS_LLM__LOCATION=us-central1
# Active GA models: gemini-2.5-flash (fast, cost-effective multimodal), gemini-2.5-pro (complex reasoning).
# On newer GCP projects where gemini-2.5-flash returns 404 NOT_FOUND, set
# MANGOMAS_LLM__LOCATION=global and MANGOMAS_LLM__MODEL=gemini-3.5-flash-lite
# (chat and embeddings hold isolated clients so embeddings can remain on us-central1).
MANGOMAS_LLM__MODEL=gemini-2.5-flash
MANGOMAS_LLM__TEMPERATURE=0.2
MANGOMAS_LLM__TIMEOUT_SECONDS=60.0

# ── Vertex AI Embeddings ──────────────────────────────────────────────────────
# Generates text embeddings via Vertex AI. Model selection is 100% Settings/env-driven.
# Active GA models:
#   - text-embedding-004: GA text embedding model (768 dimensions, default)
#   - gemini-embedding-001: Next-gen Gemini embedding model (up to 3072 dimensions)
# NOTE: Changing embedding model/dimensions requires an isolated vector store collection
# and persist dir (see MANGOMAS_VECTOR__PERSIST_DIR / MANGOMAS_VECTOR__COLLECTION below).
MANGOMAS_EMBEDDINGS__ENABLED=true
MANGOMAS_EMBEDDINGS__PROVIDER=vertex
MANGOMAS_EMBEDDINGS__PROJECT_ID=your-gcp-project-id
MANGOMAS_EMBEDDINGS__LOCATION=us-central1
MANGOMAS_EMBEDDINGS__MODEL=text-embedding-004
MANGOMAS_EMBEDDINGS__BATCH_SIZE=32

# ── Isolated Vector Store (Chroma) ───────────────────────────────────────────
# CRITICAL: Isolate persist directory and collection to prevent dimension
# collision between local 384-dim embeddings and Vertex 768-dim embeddings.
MANGOMAS_VECTOR__ENABLED=true
MANGOMAS_VECTOR__PROVIDER=chroma
MANGOMAS_VECTOR__PERSIST_DIR=./data/chroma_vertex
MANGOMAS_VECTOR__COLLECTION=mangomas_vertex
MANGOMAS_VECTOR__TOP_K=5
MANGOMAS_VECTOR__MAX_TOP_K=50

# ── RAG Chunking Parameters ───────────────────────────────────────────────────
MANGOMAS_RAG__CHUNK_WORDS=800
MANGOMAS_RAG__CHUNK_OVERLAP=120

# ── State Persistence via Cloud SQL Postgres ──────────────────────────────────
# Persists conversation turns to PostgreSQL via local Cloud SQL Auth Proxy.
MANGOMAS_DB__PROVIDER=postgres
MANGOMAS_DB__URL=postgresql://mangomas:your-db-password@127.0.0.1:5432/mangomas
MANGOMAS_DB__POOL_MIN=1
MANGOMAS_DB__POOL_MAX=10
MANGOMAS_DB__CONNECT_TIMEOUT_SECONDS=10.0

# ── GCP Secret Manager (Fail-Closed) ──────────────────────────────────────────
# Resolves application secrets from Secret Manager using ambient ADC.
MANGOMAS_SECRETS__PROVIDER=gcp
MANGOMAS_SECRETS__PROJECT_ID=your-gcp-project-id
MANGOMAS_SECRETS__TIMEOUT_SECONDS=5.0
MANGOMAS_SECRETS__DEFAULT_VERSION=latest
MANGOMAS_SECRETS__STRICT=true

# ── API Authentication (via Secret Manager token) ────────────────────────────
# Opt-in API auth; when true, secret is resolved from Secret Manager token ref.
MANGOMAS_AUTH__ENABLED=false
MANGOMAS_AUTH__SECRET_REF=mangomas-api-token-dev

# ── OpenTelemetry Cloud Telemetry (Cloud Trace & Metrics) ─────────────────────
# Exports distributed traces to Google Cloud Trace; formats stderr as Cloud Logging JSON.
MANGOMAS_TELEMETRY__EXPORTER=gcp
MANGOMAS_TELEMETRY__METRICS_ENABLED=false

# ── Structured Output Validation (Planner / Reviewer) ─────────────────────────
# Enforces strict JSON schema validation, catching markdown fences or bad payloads.
MANGOMAS_AGENTS__PLANNER__VALIDATE_OUTPUT=true
MANGOMAS_AGENTS__REVIEWER__VALIDATE_OUTPUT=true

# ── Automated Evaluation Quality Gates ────────────────────────────────────────
# Enforces CI quality gates during 'mangomas eval' runs against Vertex AI.
# Eval gating and cost limits: read before relying on these as a spending cap.
# - Any configured threshold below (MIN_MEAN_SCORE, MIN_PASS_RATE,
#   MAX_MEAN_COST_USD) engages gating on its own, even with GATE_ENABLED=false;
#   pass --no-gate to run ungated.
# - PARALLELISM=1 keeps one row in flight (no burst of parallel Gemini calls).
#   That is the only control here that limits spend *during* a run.
# - MAX_MEAN_COST_USD is evaluated after the billed run finishes, and only when
#   rows carry cost_usd (the cost_budget scorer with pricing configured). The
#   llm_judge, embedding and exact_match runs in the runbook emit no cost, so
#   the gate notes "mean_cost_usd unavailable" and skips this threshold. It is
#   a post-run regression check, not a budget: cap spend with a GCP budget alert.
MANGOMAS_EVAL__GATE_ENABLED=false
MANGOMAS_EVAL__MIN_MEAN_SCORE=0.7
MANGOMAS_EVAL__MIN_PASS_RATE=0.8
MANGOMAS_EVAL__PARALLELISM=1
MANGOMAS_EVAL__MAX_MEAN_COST_USD=0.01
