# Mango-Mas V2 — example environment configuration.
#
# Every setting is env-driven with the MANGOMAS_ prefix; nested groups join the
# group name and field with a double underscore. Uncommented lines below are
# the defaults you are most likely to change; commented blocks are opt-in
# features that are OFF by default, so an untouched deployment behaves
# identically without them.
#
# tests/deploy/test_env_example_contract.py asserts every MANGOMAS_* name here
# resolves to a real field on Settings, so this file cannot drift from config.

# ── Application ───────────────────────────────────────────────────────────────
MANGOMAS_ENV=local
MANGOMAS_LOG_LEVEL=INFO
# MANGOMAS_LOG__FORMAT=text            # text | json
# MANGOMAS_LOG__BODY_TRUNCATE=2000

# ── LLM provider ──────────────────────────────────────────────────────────────
# Built-in options: "lmstudio" (default), "vertex".
MANGOMAS_LLM__PROVIDER=lmstudio

# LM Studio (OpenAI-compatible local endpoint)
MANGOMAS_LLM__BASE_URL=http://localhost:1234/v1
MANGOMAS_LLM__MODEL=local-model
MANGOMAS_LLM__API_KEY=lm-studio
MANGOMAS_LLM__TIMEOUT_SECONDS=60
MANGOMAS_LLM__TEMPERATURE=0.2

# Vertex AI (requires the extra: pip install 'mangomas[vertex]')
# MANGOMAS_LLM__PROVIDER=vertex
# MANGOMAS_LLM__PROJECT_ID=your-gcp-project
# MANGOMAS_LLM__LOCATION=us-central1
# MANGOMAS_LLM__MODEL=gemini-1.5-flash
# Credentials: leave Application Default Credentials in place, or set a key
# path, or resolve the key body through the SecretsProvider seam.
# MANGOMAS_LLM__CREDENTIALS_PATH=/path/to/service-account.json
# MANGOMAS_LLM__SECRET_REF=VERTEX_SA_KEY_JSON

# ── Storage ───────────────────────────────────────────────────────────────────
MANGOMAS_DB__URL=sqlite:///./data/mangomas.db

# Cloud SQL / Postgres (requires the extra: pip install 'mangomas[postgres]')
# MANGOMAS_DB__PROVIDER=postgres
# MANGOMAS_DB__URL=postgresql://user:pass@host:5432/mangomas
# MANGOMAS_DB__POOL_MIN=1
# MANGOMAS_DB__POOL_MAX=10
# MANGOMAS_DB__CONNECT_TIMEOUT_SECONDS=10.0
# MANGOMAS_DB__STATEMENT_TIMEOUT_SECONDS=30.0

# ── Secrets ───────────────────────────────────────────────────────────────────
# GCP Secret Manager (requires the extra: pip install 'mangomas[gcp]').
# Identity comes from Application Default Credentials / Workload Identity
# Federation — service-account JSON keys are NOT accepted here.
# MANGOMAS_SECRETS__PROVIDER=gcp
# MANGOMAS_SECRETS__PROJECT_ID=my-gcp-project
# MANGOMAS_SECRETS__TIMEOUT_SECONDS=5.0
# MANGOMAS_SECRETS__DEFAULT_VERSION=latest
# Raise SecretsResolutionError (HTTP 503) instead of returning None on cloud
# auth/permission/timeout failures. A missing secret still returns None.
# MANGOMAS_SECRETS__STRICT=false

# ── API ───────────────────────────────────────────────────────────────────────
MANGOMAS_API__HOST=0.0.0.0
MANGOMAS_API__PORT=8000
# MANGOMAS_API__READY_TIMEOUT_SECONDS=5.0
# MANGOMAS_API__HISTORY_DEFAULT_LIMIT=50
# MANGOMAS_API__HISTORY_MAX_LIMIT=500

# Opt-in CORS. Empty allow-origins (the default) means CORSMiddleware is not
# installed at all.
# MANGOMAS_API__CORS_ALLOW_ORIGINS=["https://app.example.com"]
# MANGOMAS_API__CORS_ALLOW_METHODS=["GET","POST"]
# MANGOMAS_API__CORS_ALLOW_HEADERS=["*"]
# MANGOMAS_API__CORS_ALLOW_CREDENTIALS=false

# Opt-in backpressure (ADR-0015). 0 disables each independently.
# MANGOMAS_API__MAX_BODY_BYTES=0             # 413 when exceeded
# MANGOMAS_API__MAX_CONCURRENT_REQUESTS=0    # 503 when saturated

# ── Auth (ADR-0014; fail-closed when enabled) ─────────────────────────────────
# Health and readiness probes are never authenticated.
# MANGOMAS_AUTH__ENABLED=false
# MANGOMAS_AUTH__SECRET_REF=API_TOKEN

# ── Multi-tenancy (ADR-0017) ──────────────────────────────────────────────────
# Tenant-scoped conversation storage via a row filter.
# MANGOMAS_TENANCY__ENABLED=false
# MANGOMAS_TENANCY__HEADER=X-Tenant-ID
# MANGOMAS_TENANCY__DEFAULT=default

# ── Telemetry ─────────────────────────────────────────────────────────────────
# Span exporter: console | gcp  (gcp requires the `gcp` extra). There is no
# `otlp` token — an unknown value raises ConfigError.
# MANGOMAS_TELEMETRY__EXPORTER=console
# OTel MeterProvider (ADR-0013): agent invocation / error / duration.
# MANGOMAS_TELEMETRY__METRICS_ENABLED=false

# ── Control loop ──────────────────────────────────────────────────────────────
# MANGOMAS_LOOP__MAX_STEPS=1
# MANGOMAS_LOOP__STEP_TIMEOUT_SECONDS=30.0

# ── Memory ────────────────────────────────────────────────────────────────────
# MANGOMAS_MEMORY__ENABLED=false
# MANGOMAS_MEMORY__PROVIDER=file
# MANGOMAS_MEMORY__MEMORY_DIR=memory
# MANGOMAS_MEMORY__INDEX_FILE=MEMORY.md

# ── Per-agent overrides (MANGOMAS_AGENTS__<NAME>__*) ──────────────────────────
# <NAME> is the registered agent slug: chat, summarize, tool, planner, reviewer.
# MANGOMAS_AGENTS__CHAT__SYSTEM_PROMPT=You are a terse assistant.
# MANGOMAS_AGENTS__CHAT__TEMPERATURE=0.2
# MANGOMAS_AGENTS__CHAT__MAX_TOKENS=512
# ToolAgent only: cap on total LLM calls per request (default 5).
# MANGOMAS_AGENTS__TOOL__MAX_TOOL_STEPS=5
# SummarizeAgent only: persisted turns loaded into the summary context
# (default 10).
# MANGOMAS_AGENTS__SUMMARIZE__HISTORY_LIMIT=10
# Structured-output agents (planner/reviewer) only: validate the JSON reply
# against the agent's schema; LLMBadResponse on mismatch (default false).
# MANGOMAS_AGENTS__PLANNER__VALIDATE_OUTPUT=false
# Per-agent model, same provider as MANGOMAS_LLM__PROVIDER (spec-0028).
# MANGOMAS_AGENTS__PLANNER__MODEL_OVERRIDE=gpt-4o-mini

# ── Embeddings (opt-in; part of RAG) ──────────────────────────────────────────
# MANGOMAS_EMBEDDINGS__ENABLED=false
# MANGOMAS_EMBEDDINGS__PROVIDER=lmstudio     # lmstudio | sentence_transformers | vertex
# MANGOMAS_EMBEDDINGS__MODEL=local-model
# MANGOMAS_EMBEDDINGS__BASE_URL=http://localhost:1234/v1
# MANGOMAS_EMBEDDINGS__API_KEY=lm-studio
# MANGOMAS_EMBEDDINGS__BATCH_SIZE=32
# MANGOMAS_EMBEDDINGS__TIMEOUT_SECONDS=60.0
# Torch device for the in-process sentence_transformers backend.
# Unset = the library's own auto-detect (CUDA -> MPS -> CPU).
# MANGOMAS_EMBEDDINGS__DEVICE=cpu
# Vertex embeddings only (ADC auth; requires the `vertex` extra).
# MANGOMAS_EMBEDDINGS__PROJECT_ID=my-gcp-project
# MANGOMAS_EMBEDDINGS__LOCATION=us-central1

# ── Vector store (opt-in; requires the `rag` extra) ───────────────────────────
# MANGOMAS_VECTOR__ENABLED=false
# MANGOMAS_VECTOR__PROVIDER=chroma
# MANGOMAS_VECTOR__PERSIST_DIR=./data/chroma
# MANGOMAS_VECTOR__COLLECTION=mangomas
# MANGOMAS_VECTOR__TOP_K=5

# ── RAG chunking ──────────────────────────────────────────────────────────────
# MANGOMAS_RAG__CHUNK_WORDS=800
# MANGOMAS_RAG__CHUNK_OVERLAP=120            # validated < chunk_words

# ── Declarative workflow graphs (opt-in) ──────────────────────────────────────
# MANGOMAS_WORKFLOW__ENABLED=false
# MANGOMAS_WORKFLOW__DEFINITION=./graph.json   # a path, or inline JSON

# ── Evaluation harness (used by `mangomas eval`) ──────────────────────────────
# MANGOMAS_EVAL__DATASET_PATH=path/to/dataset.jsonl
# MANGOMAS_EVAL__SCORER=exact_match
# MANGOMAS_EVAL__SCORER_OPTIONS={}
# MANGOMAS_EVAL__AGENT=chat
# MANGOMAS_EVAL__TARGET=agent                # agent | pipeline | fan_out | echo
# MANGOMAS_EVAL__TARGET_OPTIONS={}
# MANGOMAS_EVAL__DATASET_SOURCE=jsonl        # jsonl | inline | langfuse
# MANGOMAS_EVAL__DATASET_SOURCE_OPTIONS={}
# MANGOMAS_EVAL__OUTPUT_DIR=eval-output
# MANGOMAS_EVAL__PARALLELISM=1
# MANGOMAS_EVAL__FAIL_FAST=false
# MANGOMAS_EVAL__SINKS=["console"]
# MANGOMAS_EVAL__SINK_OPTIONS={}
# MANGOMAS_EVAL__SCHEMA_VERSION=1
# CI quality gate — exit code 3 on failure, raised only after sinks emit.
# MANGOMAS_EVAL__GATE_ENABLED=false
# MANGOMAS_EVAL__MIN_MEAN_SCORE=0.8
# MANGOMAS_EVAL__MIN_PASS_RATE=0.9
# MANGOMAS_EVAL__FAIL_ON_ERROR=false
# Optional USD cost gate (not a [0,1] score). Off when unset; needs a cost-aware scorer.
# MANGOMAS_EVAL__MAX_MEAN_COST_USD=0.05
# Regression gate against a prior json_file report.
# MANGOMAS_EVAL__BASELINE_PATH=eval-output/baseline.json
# MANGOMAS_EVAL__MAX_MEAN_SCORE_DROP=0.05
# MANGOMAS_EVAL__MAX_PASS_RATE_DROP=0.05
# MANGOMAS_EVAL__ALLOW_NEW_FAILURES=true

# ── Plugin discovery (entry points) ───────────────────────────────────────────
# Enables discovery of third-party agents and eval scorers/sinks/targets/sources.
# MANGOMAS_DISCOVERY_ENABLED=false
# Let a discovered eval plugin REPLACE a built-in scorer/sink/target/source of
# the same name. Default false refuses the collision (ADR-0030): those
# registries feed the CI quality gate and the regression baseline.
# MANGOMAS_DISCOVERY_ALLOW_BUILTIN_OVERRIDE=false

# ── Claude Code harness (ADR-0021 / spec-0017; off by default) ────────────────
# MANGOMAS_HARNESS__ENABLED=false
# MANGOMAS_HARNESS__METRICS_NAMESPACE=mangomas.harness
# MANGOMAS_HARNESS__METRICS_EXPORTER=inherit   # inherit | console | gcp
# MANGOMAS_HARNESS__HOOK_LOG_LEVEL=INFO
# ConfigChange hook mode: off (default) | audit | block
# MANGOMAS_HARNESS__CONFIG_AUDIT_MODE=off

# ── Cognitive envelope emission (spec-0030 / ADR-0029; off by default) ────────
# Distinct from MANGOMAS_HARNESS__* (Claude Code governance). When enabled,
# planner/reviewer handle() appends CognitiveSignal 1.1.0 JSONL; failures are
# logged and swallowed so dispatch is unchanged.
# MANGOMAS_SIGNAL__ENABLED=false
# MANGOMAS_SIGNAL__DIR=./data/cognitive-signals
# MANGOMAS_SIGNAL__SCHEMA_VERSION=1.1.0
# MANGOMAS_SIGNAL__GENAI_SPANS=false
# MANGOMAS_SIGNAL__POLICY_ID=mangomas.cognitive.default
# MANGOMAS_SIGNAL__POLICY_VERSION=1
# Changing POLICY_ID or POLICY_VERSION without an explicit hash rebinds this
# to sha256(id:version). Set POLICY_SNAPSHOT_HASH only to pin a prior snapshot.
# MANGOMAS_SIGNAL__POLICY_SNAPSHOT_HASH=sha256:b2fecba717580bca4de7ad91980a40635159aa8adcebf62822ba11e4a8084349
# Optional POST to a harness ingest route when that API exists; JSONL is enough.
# MANGOMAS_SIGNAL__HTTP_URL=
# MANGOMAS_SIGNAL__HTTP_TIMEOUT_SECONDS=5.0
