# Application
MANGOMAS_ENV=local
MANGOMAS_LOG_LEVEL=INFO

# LLM provider selection. Built-in options: "lmstudio" (default), "vertex".
MANGOMAS_LLM__PROVIDER=lmstudio

# LM Studio (OpenAI-compatible local endpoint)
MANGOMAS_LLM__BASE_URL=http://localhost:1234/v1
MANGOMAS_LLM__MODEL=local-model
MANGOMAS_LLM__API_KEY=lm-studio
MANGOMAS_LLM__TIMEOUT_SECONDS=60
MANGOMAS_LLM__TEMPERATURE=0.2

# Vertex AI (uncomment + install the extra: pip install 'mangomas[vertex]')
#MANGOMAS_LLM__PROVIDER=vertex
#MANGOMAS_LLM__PROJECT_ID=your-gcp-project
#MANGOMAS_LLM__LOCATION=us-central1
#MANGOMAS_LLM__MODEL=gemini-1.5-flash
# One of: leave Application Default Credentials in place, or set a key path:
#MANGOMAS_LLM__CREDENTIALS_PATH=/path/to/service-account.json
# Or resolve via the SecretsProvider seam (env-var backend by default):
#MANGOMAS_LLM__SECRET_REF=VERTEX_SA_KEY_JSON

# Vertex AI Gemini (uncomment to enable; requires the `vertex` extra)
# Identity is sourced from Application Default Credentials / Workload Identity
# Federation. Run `gcloud auth application-default login` locally; rely on
# ambient identity on GCP. Service-account JSON keys are NOT supported.
# MANGOMAS_LLM__PROVIDER=vertex
# MANGOMAS_LLM__PROJECT=my-gcp-project
# MANGOMAS_LLM__LOCATION=us-central1
# MANGOMAS_LLM__MODEL=gemini-1.5-flash
# MANGOMAS_LLM__MAX_OUTPUT_TOKENS=1024

# Storage
MANGOMAS_DB__URL=sqlite:///./data/mangomas.db

# Cloud SQL / Postgres (uncomment to enable; requires the `postgres` extra)
# MANGOMAS_DB__PROVIDER=postgres
# MANGOMAS_DB__URL=postgresql://user:pass@host:5432/mangomas
# MANGOMAS_DB__POOL_MIN=1
# MANGOMAS_DB__POOL_MAX=10
# MANGOMAS_DB__CONNECT_TIMEOUT_SECONDS=10.0
# MANGOMAS_DB__STATEMENT_TIMEOUT_SECONDS=30.0

# GCP Secret Manager (uncomment to enable; requires the `gcp` extra)
# Identity is sourced from Application Default Credentials / Workload Identity
# Federation — service-account JSON keys are NOT accepted. Run
# `gcloud auth application-default login` locally; rely on the runtime's
# ambient identity on GCP.
# MANGOMAS_SECRETS__PROVIDER=gcp
# MANGOMAS_SECRETS__PROJECT_ID=my-gcp-project
# MANGOMAS_SECRETS__TIMEOUT_SECONDS=5.0
# MANGOMAS_SECRETS__DEFAULT_VERSION=latest
# MANGOMAS_LLM__SECRET_REF=lm-studio-api-key  # short id; full resource paths also accepted

# API
MANGOMAS_API__HOST=0.0.0.0
MANGOMAS_API__PORT=8000

# Evaluation harness (used by `mangomas eval`)
#MANGOMAS_EVAL__DATASET_PATH=path/to/dataset.jsonl
#MANGOMAS_EVAL__SCORER=exact_match
#MANGOMAS_EVAL__AGENT=chat
#MANGOMAS_EVAL__PARALLELISM=1
#MANGOMAS_EVAL__FAIL_FAST=false
