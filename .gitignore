# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.eggs/
build/
dist/

# Tests / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
# Hypothesis example database (written by the fuzz tests in test_tools.py)
.hypothesis/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.*
!.env.example

# Data
data/
*.db
*.sqlite
*.sqlite3

# RAG / vector store artefacts (default persist dir is ./data/chroma, already
# covered by data/; these catch non-default persist dirs and local caches)
chroma/
*.chroma
.chroma/

# Local model / embedding caches (sentence-transformers downloads to HF cache;
# only relevant if a contributor points the cache inside the repo)
.cache/
.sentence_transformers/
.hf_cache/

# IDE
.vscode/
.idea/
.DS_Store

# Runtime / local state
memory/
eval-output/
*.log
*.tmp

# Claude Code harness — local overrides + hook scratch state
.claude/settings.local.json
.claude/cache/
.claude/state/
.claude/logs/

# Test artefacts
.tox/

# Defensive (JS tooling not in project but gitignore is inherited)
node_modules/

# Antigravity / Gemini agent workspace
.gemini/
docs/antigravity_reference.md

# Dev scratch (one-off scripts, not shipped)
scratch/
TESTING_WORKFLOW.md
